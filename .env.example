# Copy to .env (never commit .env) and fill in the real values.

# Jenkins controller
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
REPO_URL=https://github.com/GabrielRenat0/Projeto-Qualidade-.git

# Pipeline notification (sent to the mailpit service, which relays to Gmail)
NOTIFY_EMAIL_TO=member1@example.com,member2@example.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=pipeline@example.com

# Gmail account used by mailpit to relay messages (only mailpit receives these)
GMAIL_USER=project-account@example.com
GMAIL_APP_PASSWORD=change-me

# API under test
API_BASE_URL=https://jsonplaceholder.typicode.com
